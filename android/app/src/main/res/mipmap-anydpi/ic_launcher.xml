<?xml version="1.0" encoding="utf-8"?>
<!-- The Release build's launcher icon: the heart on white, plus a monochrome
     heart with the trace cut out, which launchers tint for themed icons.
     The app needs Android 12 (API 31) or later, so it has no legacy PNG
     icons and no round icon. tool/make_build_icons.swift makes the layers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
